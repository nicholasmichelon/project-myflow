skinparam classFontStyle bold
hide circle

class Disciplina {
  -_id : int | None
  -_nome : str
  -_codigo : str
  -_carga_horaria : int
  --
  +id : int | None
  +nome : str
  +codigo : str
  +carga_horaria : int
  --
  +__init__(nome, codigo, carga_horaria, id=None)
  +exibir_ficha() : None
